# Copy to backend/.env and fill in. Nothing in here is committed.

# OpenRouter — required for source analysis, post generation and image generation.
OPENROUTER_API_KEY=

# Tavily — optional, only used by the (hidden) web image search fallback.
TAVILY_API_KEY=

# Fallback public HTTPS base URL (used only when LINKEDIN_REDIRECT_URI is empty).
# During development with a quick tunnel:
#   cloudflared tunnel --url http://localhost:8000
# then paste the printed https://<words>.trycloudflare.com URL here.
PUBLIC_BASE_URL=http://localhost:8000

# Stable redirect URI registered in the LinkedIn app. Prefer this over a
# tunnel: it never changes. The Supabase edge function in supabase/ serves as
# a bridge and forwards the browser to this backend. Example:
#   https://<project-ref>.supabase.co/functions/v1/linkedin-callback
LINKEDIN_REDIRECT_URI=

# Where the browser lands after the OAuth callback (the Vite dev server).
FRONTEND_SUCCESS_URL=http://localhost:5173

# LinkedIn — https://www.linkedin.com/developers/apps
# Products needed: Share on LinkedIn + Sign In with LinkedIn using OpenID Connect.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Where generated images are written, relative to backend/.
MEDIA_DIR=media
